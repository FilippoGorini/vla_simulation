<sdf version='1.9'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.8 0.8 0.9 1</background>
      <shadows>true</shadows>
      <shadow_caster_render_back_faces>false</shadow_caster_render_back_faces>
      <sky></sky>
    </scene>
    
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    
    <include>
      <uri>model://table_vla</uri>
      <name>table_vla</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://craftsman_grip_screwdriver_phillips_cushion</uri>
      <name>craftsman_grip_screwdriver_phillips_cushion</name>
      <pose>0.15 0.3 0.8 0 0 0</pose>
    </include>

    <include>
      <uri>model://cole_hardware_hammer_black</uri>
      <name>cole_hardware_hammer_black</name>
      <pose>0.15 -0.3 0.8 0 0 0</pose>
    </include>

    <include>
      <uri>model://3M_Vinyl_Tape_Green_1_x_36_yd</uri>
      <name>3M_Vinyl_Tape_Green_1_x_36_yd</name>
      <pose>0 0 0.8 0.4 0.2 0</pose>
    </include>

    <!-- Natural light from a "window" (Reduced Intensity) -->
    <light name='sun_directional' type='directional'>
      <pose>10 10 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.4</intensity>
      <direction>-0.5 -0.5 -1.0</direction>
      <diffuse>0.9 0.9 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Overhead Lab Lighting (Reduced Intensity) -->
    <light name='ceiling_panel_1' type='point'>
      <pose>1.5 1.5 4.0 0 0 0</pose>
      <intensity>0.25</intensity>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.9</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name='ceiling_panel_2' type='point'>
      <pose>1.5 -1.5 4.0 0 0 0</pose>
      <intensity>0.25</intensity>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.9</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name='ceiling_panel_3' type='point'>
      <pose>-1.5 1.5 4.0 0 0 0</pose>
      <intensity>0.25</intensity>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.9</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name='ceiling_panel_4' type='point'>
      <pose>-1.5 -1.5 4.0 0 0 0</pose>
      <intensity>0.25</intensity>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.9</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>
