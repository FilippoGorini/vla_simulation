        <pose>0.018131 0.037267 0.006573 0 0 0</pose>
        <mass>0.07330218</mass>
        <inertia>
          <ixx>1.26800276e-04</ixx>
          <ixy>-1.86548405e-05</ixy>
          <ixz>-1.20356253e-06</ixz>
          <iyy>2.53721247e-05</iyy>
          <iyz>-3.58531338e-06</iyz>
          <izz>1.50855405e-04</izz>
        </inertia>
      </inertial>
    </link>
