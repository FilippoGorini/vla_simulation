<sdf version="1.6">
    <model name="Craftsman_Grip_Screwdriver_Phillips_Cushion">
        <link name="link_0">
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/model.obj</uri>
                        <scale>0.8 0.8 0.8</scale>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision_0">
                <geometry>
                    <mesh>
                        <uri>meshes/model.obj</uri>
                        <scale>0.8 0.8 0.8</scale>
                    </mesh>
                </geometry>
            </collision>
<!-- The inertial parameters are approximations computed in Blender assuming homogeneous density -->
            <inertial>
                <pose>0.059805 0.004184 0.015692 0 0 0</pose>
                <mass>0.10775883</mass>
                <inertia>
                    <ixx>8.46336297e-06</ixx>
                    <ixy>3.15206393e-07</ixy>
                    <ixz>-1.00117877e-05</ixz>
                    <iyy>1.34597693e-04</iyy>
                    <iyz>6.45232490e-08</iyz>
                    <izz>1.33794761e-04</izz>
                </inertia>
            </inertial>
        </link>
    </model>
</sdf>
